build/
build-*/
timaert_c/
jopus/
Testing/
imgui.ini

/artifacts/
/.vscode
/.cache
/concepts
.DS_Store

# Local runtime smoke/evidence artifacts.
/runtime_*.png
/runtime_*.ppm
/runtime_*.out
/runtime_*.err
/runtime_*.log
/runtime_*.txt
/smoke_*.png
/smoke_*.ppm
/smoke_*.out
/smoke_*.err
/smoke_*.log
/smoke_*.txt
# ...but the SUITE is not an artifact, it is the source list of scenarios
# smoke.sh runs (`sh smoke.sh all`). It matches /smoke_*.txt by accident of
# naming, and without this line it would have been born ignored: green on the
# machine that wrote it, "smoke_suite.txt not found" on every other.
!/smoke_suite.txt
/save.bin
/save.bin.tmp
/save.bin.bak
# save_roundtrip_test writes its fixtures through temp_save_path, which falls
# back to "." when neither TEMP nor TMP is set — and macOS sets only TMPDIR.
# So running the test binary from the repo root drops these here every time;
# one of them (timaert_save_roundtrip_v8.bin) rode into 08f941b that way.
/timaert_*.bin
/*.obj
/*.diff
/*.patch
/*.rej
/*.orig

# Imported reference trees can contain build outputs; keep docs/logs, skip binaries.
/Docs/**/CodexArtifacts/
/Docs/**/.codex-artifacts/

# Broad Hecton import buckets are local quarantine only, not first-push Timaert docs.
/Docs/AgentLogs/Imported_Hecton8/
/Docs/Reports/Imported_Hecton8/
/Docs/Tasks/Imported_Hecton8/

# balance harness TSV output (tests/balance_run.cpp)
balance_out*/

# ── СЕКРЕТЫ: НИКОГДА НЕ В РЕПОЗИТОРИЙ ─────────────────────────────────────
# Репозитории проекта ПУБЛИЧНЫЕ (Jirnyak/Timaert — официальный,
# tenevik-games/timaert — зеркало под виндосборки), поэтому один `git add -A`
# опубликовал бы это навсегда: из истории такое не вычищается просто.
# Шире маски нарочно — коды спасения приходят под разными именами.
*recovery-code*
*recovery_code*
*.key
*secret*
*credentials*
.env

# ── ВНЕ ИГРЫ: КАРТИНКИ, КОТОРЫХ КОД НЕ ЧИТАЕТ (2026-11-09) ────────────────
# Вынесены из дерева в `../timaert-attic/`, не удалены. Перепись перед
# выносом: упоминаний в `src/` — НОЛЬ у всех трёх, в доках — ноль; живые
# ветки ассетов остались на месте (sprites 9 упоминаний, sound 6,
# backgrounds 3, fonts 1). Маски стоят, чтобы папки не заехали обратно
# молча — 10 МиБ, которых игра не спрашивает.
/assets/memes/
/assets/visual_benchmarks/
/assets/illustrations/
